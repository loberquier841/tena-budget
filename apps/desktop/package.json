{
  "name": "@tena/desktop",
  "version": "1.0.0",
  "main": "main.js",
  "description": "TENA Budget offline",
  "author": "TENA",
  "scripts": {
    "dev": "electron . --no-sandbox",
    "build": "electron-builder --linux --win --mac",
    "build:linux": "electron-builder --linux --dir",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:appimage": "electron-builder --linux"
  },
  "build": {
    "appId": "fr.tena.budget",
    "productName": "TENA Budget",
    "electronVersion": "44.5.1",
    "files": [
      "main.js",
      "../mobile/dist/**/*",
      "assets/**/*",
      "locale/**/*"
    ],
    "linux": {
      "target": [
        "dir",
        "AppImage"
      ]
    },
    "win": {
      "target": "exe",
      "arch": [
        "x64",
        "ia32"
      ]
    },
    "mac": {
      "target": ["default"],
      "icon": "assets/TENΛ Budget.icns"
    }
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3"
  }
}