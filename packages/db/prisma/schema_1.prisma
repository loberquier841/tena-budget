
generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// === FONDATIONS ÉTAPE 1 - Modèle complet V1.1 mais non migré ===
model User {
  id String @id @default(cuid())
  email String @unique
  name String?
  passwordHash String // bcrypt
  createdAt DateTime @default(now())
  families FamilyMember[]
  auditLogs AuditLog[]
}

model Family {
  id String @id @default(cuid())
  name String
  createdAt DateTime @default(now())
  members FamilyMember[]
  budgets Budget[]
  persons Person[]
  bankConnections BankConnection[]
}

model FamilyMember {
  id String @id @default(cuid())
  userId String
  familyId String
  role String // owner, admin, member, child
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id])
  family Family @relation(fields: [familyId], references: [id])
  @@unique([userId, familyId])
}

model Person {
  id String @id @default(cuid())
  familyId String
  name String
  family Family @relation(fields: [familyId], references: [id])
}

model Budget {
  id String @id @default(cuid())
  familyId String
  type String // annual, monthly
  year Int
  month Int?
  family Family @relation(fields: [familyId], references: [id])
}

model Category {
  id String @id @default(cuid())
  familyId String
  name String
  parentId String?
}

model Transaction {
  id String @id @default(cuid())
  familyId String
  amountCents Int // montants en centimes, jamais float
  bookingDate DateTime
  label String
  source String // manual, import, bank
  categoryId String?
  personId String?
  isDeleted Boolean @default(false)
  createdAt DateTime @default(now())
}

model RecurringRule {
  id String @id @default(cuid())
  familyId String
  personId String? // budget par personne
  categoryId String?
  label String
  amountCents Int // Int centimes, jamais float
  periodicity String // weekly, monthly
  dayOfWeek Int? // 0-6 pour weekly
  dayOfMonth Int? // 1-31 pour monthly
  startDate DateTime
  endDate DateTime?
  isActive Boolean @default(true)
  createdByUserId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDeleted Boolean @default(false)
  deletedAt DateTime?
  generations RecurringGenerationLog[]
  @@index([familyId, isActive])
  @@index([familyId, personId])
}

model RecurringGenerationLog {
  id String @id @default(cuid())
  ruleId String
  generatedAt DateTime @default(now())
  generatedTransactionId String? // lien vers Transaction réelle créée après validation
  periodStart DateTime
  periodEnd DateTime
  amountCents Int
  status String // pending_validation, generated, skipped
  rule RecurringRule @relation(fields: [ruleId], references: [id])
  @@index([ruleId])
}



model SavingContribution {
  id String @id @default(cuid())
  goalId String
  amountCents Int // Int, positif pour ajout, négatif pour retrait si autorisé
  bookingDate DateTime @default(now())
  note String?
  createdByUserId String
  goal SavingGoal @relation(fields: [goalId], references: [id])
  @@index([goalId])
}


model ImportJob {
  id String @id @default(cuid())
  familyId String
  status String // analyzing, awaiting_validation, imported
  createdAt DateTime @default(now())
  // 6 couches stockées en JSON pour audit
  fileOriginalRef String?
  dataAnalyzed Json?
  dataRecognized Json?
  dataAmbiguous Json?
  dataValidated Json?
  dataFinal Json?
}

model SimulationScenario {
  id String @id @default(cuid())
  familyId String
  name String
  createdAt DateTime @default(now())
  // Aucun FK vers Transaction réelle - isolation totale
}

model SimulationTransaction {
  id String @id @default(cuid())
  scenarioId String
  amountCents Int
  label String
  bookingDate DateTime
  scenario SimulationScenario @relation(fields: [scenarioId], references: [id])
}

model BankConnection {
  id String @id @default(cuid())
  familyId String
  userId String
  providerId String
  consentId String?
  status String
  consentExpiresAt DateTime?
  lastSyncAt DateTime?
  createdAt DateTime @default(now())
  revokedAt DateTime?
  family Family @relation(fields: [familyId], references: [id])
  accounts BankAccount[]
  syncLogs BankSyncLog[]
}

model BankAccount {
  id String @id @default(cuid())
  connectionId String
  externalId String
  name String
  ibanMasked String
  balanceCents Int
  currency String @default("EUR")
  connection BankConnection @relation(fields: [connectionId], references: [id])
  transactionsRaw BankTransactionRaw[]
}

model BankTransactionRaw {
  id String @id @default(cuid())
  accountId String
  externalId String @unique
  amountCents Int
  bookingDate DateTime
  label String
  rawData Json
  hashDedup String
  importedAsTransactionId String?
  account BankAccount @relation(fields: [accountId], references: [id])
  @@index([hashDedup])
}

model BankSyncLog {
  id String @id @default(cuid())
  connectionId String
  startedAt DateTime @default(now())
  finishedAt DateTime?
  status String
  errorCode String?
  transactionsFetched Int @default(0)
  connection BankConnection @relation(fields: [connectionId], references: [id])
}

model Device {
  id String @id @default(cuid())
  familyId String
  userId String
  publicKey String?
  lastSeenAt DateTime @default(now())
  // limite 3 appareils vérifiée côté serveur
}

model AuditLog {
  id String @id @default(cuid())
  familyId String?
  userId String
  action String
  entity String
  entityId String?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id])
}
